// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String
  fatherName        String?
  motherName        String?
  email             String         @unique
  password          String
  profileImage      String?
  phoneNumber       String?
  bloodGroup        BloodGroup     @default(UNKNOWN)
  bio               String?
  summary           String?
  status            UserStatus     @default(ACTIVE)
  role              Role           @default(USER)
  profession        String?
  village           String?
  currentLocation   String?
  whatsappNumber    String?
  membershipType    MembershipType @default(PERMANENT)
  facebookProfile   String?
  authProvider      AuthProvider   @default(EMAIL)
  emailVerified     Boolean        @default(false)
  phoneVerified     Boolean        @default(false)
  adminVerified     Boolean        @default(false)
  googleId          String?
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?
  resetOtpVerified  Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Member {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  slug              String     @unique // your old "emon" id
  nameEn            String
  nameBn            String
  roleEn            String
  roleBn            String
  image             String?
  villageEn         String
  villageBn         String // URL or path
  summaryEn         String
  summaryBn         String
  keyContributionEn String[]   @default([])
  keyContributionBn String[]   @default([])
  mottoEn           String?
  mottoBn           String?
  joiningYear       String
  isKeyLeader       Boolean    @default(false)
  type              MemberType @default(COMMITTEE)
  order             Int        @default(0) // controls display order
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum MemberType {
  PIONEER
  COMMITTEE
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipType {
  PERMANENT
  PLAYER_QUOTA
}

enum AuthProvider {
  GOOGLE
  EMAIL
}
